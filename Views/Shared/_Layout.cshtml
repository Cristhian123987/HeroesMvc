<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HeroesMvc</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; margin: 0; background: #f6f7f9; color: #222; }
        header { background: #1f2a44; color: #fff; padding: 14px 24px; }
        main { max-width: 900px; margin: 24px auto; padding: 0 16px; }
        .card { background: #fff; border: 1px solid #dde1e7; border-radius: 8px; padding: 16px 20px; margin-bottom: 16px; }
        a { color: #1a5fb4; }
        .error { color: #b00020; }
        code { background: #eef0f3; padding: 1px 5px; border-radius: 4px; }
    </style>
</head>
<body>
    <header><strong>HeroesMvc</strong> — Clase 02: Fluent API con archivos de configuración</header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
